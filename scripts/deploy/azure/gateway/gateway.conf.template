# ${APP_PORT} is filled in at container start (nginx image template support).
server_tokens off;

# The Container Apps ingress appends the caller's address last in X-Forwarded-For.
real_ip_header X-Forwarded-For;
set_real_ip_from 0.0.0.0/0;
real_ip_recursive off;

# At most 10 requests a second per caller (bursts of 40), checked before the login.
limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;
limit_req_status 429;

server {
    listen 8080;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Never serve hidden files (.env, .git, ...), even to logged-in users.
    location ~ /\. {
        return 404;
    }

    location / {
        limit_req zone=per_ip burst=40 nodelay;
        limit_except GET HEAD POST PUT PATCH DELETE OPTIONS { deny all; }

        auth_basic "OmniTech cloud";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_read_timeout 300s;
    }
}
